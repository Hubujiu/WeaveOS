{
  "openapi": "3.2.1",
  "info": {
    "title": "WeaveOS v0.1.0 Authentication API",
    "version": "1.0.0",
    "description": "Product version v0.1.0; public compatibility path /api/v1. Browser session authentication follows ADR-001. This contract does not define general RBAC or cross-service RPC."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/registrations": {
      "post": {
        "operationId": "createRegistration",
        "summary": "Register with one unused invitation",
        "security": [],
        "description": "Requires an allowed same-origin Origin. Missing Origin requires a verified same-origin Referer or a suitable CSRF proof. Only application/json is accepted. Account is trimmed at both ends; case is preserved and internal spaces are rejected. Registration never creates a Session. Invitation consumption and account creation are atomic.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "account",
                  "password",
                  "invitationCode"
                ],
                "additionalProperties": false,
                "properties": {
                  "account": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 254,
                    "description": "Trim leading/trailing spaces, preserve case, reject any remaining spaces. Whether differently cased accounts conflict remains under review.",
                    "x-account-normalization": {
                      "caseFolding": false,
                      "trimEdgeSpaces": true,
                      "rejectInternalWhitespace": true
                    }
                  },
                  "password": {
                    "type": "string",
                    "minLength": 4,
                    "format": "password",
                    "description": "At least one uppercase ASCII letter, lowercase ASCII letter, digit, and special character; no additional length minimum in v0.1.0."
                  },
                  "invitationCode": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Validated and consumed once by the server; never recorded in ordinary logs."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created; no Session cookie",
            "headers": {
              "Location": {
                "description": "New user resource",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Log in with account and password",
        "security": [],
        "description": "Requires the same Origin/CSRF and JSON media policy as registration. Unknown account, wrong password and Disabled account share the public invalid-credentials result. A successful login creates a fresh random server-side Redis Session with one-hour idle TTL and an HttpOnly Secure SameSite cookie.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "account",
                  "password"
                ],
                "additionalProperties": false,
                "properties": {
                  "account": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New Session created",
            "headers": {
              "Set-Cookie": {
                "description": "__Host-weaveos_session with Secure; HttpOnly; SameSite=Lax; Path=/; and one-hour browser lifetime",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/sessions/current": {
      "get": {
        "operationId": "getCurrentSession",
        "summary": "Read the authenticated user",
        "security": [
          {
            "WebSession": []
          }
        ],
        "description": "Successful authenticated activity renews the Redis idle TTL to one hour and synchronizes browser cookie lifetime. Identity is checked from the server-side Session and current user state.",
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEnvelope"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "head": {
        "operationId": "headCurrentSession",
        "summary": "Check current Session without a response body",
        "security": [
          {
            "WebSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated; no body",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "401": {
            "description": "Unauthenticated; no body",
            "headers": {
              "WWW-Authenticate": {
                "$ref": "#/components/headers/SessionChallenge"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "503": {
            "description": "Session cannot be verified; no body",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteCurrentSession",
        "summary": "Log out the current Session",
        "security": [
          {
            "WebSession": []
          }
        ],
        "description": "Requires an allowed same-origin Origin, verified Referer or appropriate CSRF proof. Deletes the server-side Session before reporting success; concurrent renewal cannot recreate it. Browser cookie is expired.",
        "responses": {
          "204": {
            "description": "Current Session revoked; no body",
            "headers": {
              "Set-Cookie": {
                "description": "Expire __Host-weaveos_session",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/invitations": {
      "post": {
        "operationId": "createInvitation",
        "summary": "Bootstrap Admin creates a one-use invitation",
        "security": [
          {
            "WebSession": []
          }
        ],
        "description": "Only the current Bootstrap Admin may create an invitation. A generated code has no time expiry and is displayed once. Requires same-origin/CSRF proof and application/json body.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation created",
            "headers": {
              "Location": {
                "description": "New invitation resource",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/users/{userId}/password-reset": {
      "post": {
        "operationId": "resetUserPassword",
        "summary": "Bootstrap Admin resets a user's password",
        "security": [
          {
            "WebSession": []
          }
        ],
        "description": "Only the current Bootstrap Admin may reset. The new password is the PRD-mandated fixed value and is never returned or logged. Existing Sessions for the target are invalidated under the approved data-design revision. Requires same-origin/CSRF proof and application/json body.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset, without password in body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetEnvelope"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "WebSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-weaveos_session"
      }
    },
    "headers": {
      "SessionChallenge": {
        "description": "Session realm=\"enterprise-management-system\"",
        "schema": {
          "type": "string",
          "const": "Session realm=\"enterprise-management-system\""
        }
      },
      "RequestId": {
        "schema": {
          "minLength": 1,
          "type": "string"
        },
        "description": "Server-issued correlation ID; caller-supplied X-Request-Id is ignored"
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {},
          "meta": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "requestId": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "account"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "account": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "UserEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "const": "OK"
              },
              "data": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        ]
      },
      "Invitation": {
        "type": "object",
        "required": [
          "id",
          "invitationCode"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "invitationCode": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "InvitationEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "const": "OK"
              },
              "data": {
                "$ref": "#/components/schemas/Invitation"
              }
            }
          }
        ]
      },
      "ResetEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "const": "OK"
              },
              "data": {
                "type": "null"
              }
            }
          }
        ]
      },
      "ErrorEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "null"
              }
            }
          }
        ]
      },
      "Violation": {
        "type": "object",
        "required": [
          "location",
          "field",
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "location": {
            "type": "string",
            "enum": [
              "body",
              "query",
              "path",
              "header"
            ]
          },
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ValidationErrorData": {
        "type": "object",
        "required": [
          "violations"
        ],
        "additionalProperties": false,
        "properties": {
          "violations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Violation"
            }
          }
        }
      },
      "ValidationEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "const": "COMMON_VALIDATION_FAILED"
              },
              "data": {
                "$ref": "#/components/schemas/ValidationErrorData"
              }
            }
          }
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request, invalid invitation, or field validation",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                {
                  "$ref": "#/components/schemas/ValidationEnvelope"
                }
              ]
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid credentials or unverified Session",
        "headers": {
          "WWW-Authenticate": {
            "$ref": "#/components/headers/SessionChallenge"
          },
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Forbidden": {
        "description": "CSRF rejection or Bootstrap capability denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "NotFound": {
        "description": "Target user not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "Conflict": {
        "description": "Account already exists or invitation already used",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Only application/json is accepted for credential writes",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "Unavailable": {
        "description": "A required authentication dependency cannot be verified",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "InternalError": {
        "description": "Internal error with safe public detail only",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      }
    }
  }
}
