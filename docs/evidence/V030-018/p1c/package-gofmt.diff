+	changed.PayloadHash[1] = 7
+	tx := f.begin(t)
+	if _, e := f.ledger.AcceptInTx(f.ctx, tx, changed); !errors.Is(e, ErrConflict) {
+		t.Fatalf("same key different payload: %v", e)
+	}
+	_ = tx.Rollback(f.ctx)
+	tx = f.begin(t)
+	v, e := f.ledger.GetInTx(f.ctx, tx, c.CommandID)
+	if e != nil || v.Command != c {
+		t.Fatalf("original overwritten %+v %v", v, e)
+	}
+	_ = tx.Rollback(f.ctx)
+	f.counts(t, 1, 1, 0, 11, true)
+}
