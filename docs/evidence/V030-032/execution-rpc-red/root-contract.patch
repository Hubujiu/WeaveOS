diff --git a/contracts/proto/weaveos/workflow/v1/execution.proto b/contracts/proto/weaveos/workflow/v1/execution.proto
new file mode 100644
index 0000000..1065b30
--- /dev/null
+++ b/contracts/proto/weaveos/workflow/v1/execution.proto
@@ -0,0 +1,34 @@
+syntax = "proto3";
+package weaveos.workflow.v1;
+import "weaveos/workflow/v1/deployment.proto";
+option java_package = "org.weaveos.workflow.v1";
+option java_multiple_files = true;
+option go_package = "github.com/Hubujiu/WeaveOS/services/bff/internal/workflowrpc/pb";
+service ExecutionService {
+ rpc Execute(ExecutionRequest) returns (ExecutionReceipt);
+ rpc Lookup(ExecutionLookupRequest) returns (ExecutionLookupResponse);
+ rpc EstablishNoEffect(ExecutionRequest) returns (ExecutionReceipt);
+}
+message ExecutionRequest {
+ bytes command_envelope = 1;
+ bytes payload = 2;
+}
+message ExecutionReceipt {
+ string command_id = 1;
+ bytes command_hash = 2;
+ string outcome = 3;
+ uint64 sequence = 4;
+ string proof_id = 5;
+ bytes result_hash = 6;
+ bytes result_bytes = 7;
+}
+message ExecutionLookupRequest {
+ string command_id = 1;
+ bytes command_hash = 2;
+}
+message ExecutionLookupResponse {
+ oneof result {
+  ExecutionReceipt confirmed = 1;
+  NotObserved not_observed = 2;
+ }
+}
