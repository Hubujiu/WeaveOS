+package apprecordservice
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/Hubujiu/WeaveOS/services/bff/internal/appfields"
+	"github.com/Hubujiu/WeaveOS/services/bff/internal/applications"
