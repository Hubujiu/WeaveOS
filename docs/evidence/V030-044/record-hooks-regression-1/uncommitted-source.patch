+func TestRootRecordTriggersDeniedWriteCreatesNoIntent(t *testing.T) {
+	f := newRecordFixture(t)
+	rootConfiguredTrigger(t, f, "record.created", nil)
+	req := rootTriggerCreateRequest(t, f, "alpha")
