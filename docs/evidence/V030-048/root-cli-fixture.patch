+package main
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// The CLI owns two empty, actually migrated databases. Other packages deliberately
+// leave conflicting historical rows; their fault fixtures cannot define this
+// command-line test's successful baseline. No shared test or production rows are
+// deleted, and only names generated by this invocation may be dropped.
+func maintenanceDatabases(t *testing.T) (string, string) {
+	t.Helper()
+	source := os.Getenv("WEAVEOS_TEST_DATABASE_URL")
+	if source == "" {
+		t.Fatal("isolated PostgreSQL test database required")
+	}
+	parsed, err := url.Parse(source)
+	if err != nil || (parsed.Scheme != "postgres" && parsed.Scheme != "postgresql") {
+		t.Fatal("isolated test URL must use PostgreSQL URI format")
+	}
+	cfg, err := pgx.ParseConfig(source)
+	if err != nil {
+		t.Fatal("invalid isolated PostgreSQL configuration")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	owner, err := pgx.ConnectConfig(ctx, cfg)
+	if err != nil {
+		t.Fatal("isolated PostgreSQL fixture connection failed")
+	}
+	t.Cleanup(func() {
+		if err := owner.Close(context.Background()); err != nil {
+			t.Error("fixture connection close failed")
+		}
+	})
+	goose, err := exec.LookPath("goose")
+	if err != nil {
+		output, e := exec.Command("go", "env", "GOPATH").Output()
+		if e != nil {
+			t.Fatal("Go tools path unavailable")
+		}
+		suffix := ""
+		if runtime.GOOS == "windows" {
+			suffix = ".exe"
+		}
+		goose = filepath.Join(strings.Split(strings.TrimSpace(string(output)), string(os.PathListSeparator))[0], "bin", "goose"+suffix)
+		if _, e = os.Stat(goose); e != nil {
+			t.Fatal("existing Goose migration CLI required")
+		}
+	}
+	create := func(kind, folder string) string {
+		t.Helper()
+		var entropy [8]byte
+		if _, err := rand.Read(entropy[:]); err != nil {
+			t.Fatal(err)
+		}
+		name := "weaveos_v048_cli_" + kind + "_" + hex.EncodeToString(entropy[:])
+		quoted := pgx.Identifier{name}.Sanitize()
+		if _, err := owner.Exec(ctx, "CREATE DATABASE "+quoted); err != nil {
+			t.Fatal("creating dedicated CLI fixture database failed")
+		}
+		t.Cleanup(func() {
+			cleanup, stop := context.WithTimeout(context.Background(), 10*time.Second)
+			defer stop()
+			if _, err := owner.Exec(cleanup, "DROP DATABASE "+quoted); err != nil {
+				t.Errorf("dropping owned CLI fixture %s failed", name)
+			}
+		})
+		target := *parsed
+		target.Path = "/" + name
+		target.RawPath = ""
+		dsn := target.String()
+		command := exec.CommandContext(ctx, goose, "-dir", filepath.Join("../../../..", "db", folder), "postgres", dsn, "up")
+		if _, err := command.CombinedOutput(); err != nil {
+			t.Fatalf("published %s migrations failed in dedicated fixture", kind)
+		}
+		return dsn
+	}
+	return create("live", "migrations"), create("cold", "archive-migrations")
+}
