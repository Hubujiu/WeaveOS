+func boundDeletion(r *pb.FlowDeletionReceipt, app, flow, operation string) bool {
+	return r != nil && proto.Size(r) <= maxDeletionMessage && r.AppId == app && r.FlowId == flow && r.OperationId == operation && r.DeletedVersions <= maxVersion && r.DeletedAtSeconds >= 1 && r.DeletedAtSeconds <= 253402300799 && r.DeletedAtNanos >= 0 && r.DeletedAtNanos <= 999999999 && r.DeletedAtNanos%1000 == 0
+}
