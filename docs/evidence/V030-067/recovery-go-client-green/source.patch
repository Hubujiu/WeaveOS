+// DeleteFlow sends once; an uncertain transport outcome must be recovered by the original identity.
 func (c *Client) DeleteFlow(ctx context.Context, in *pb.FlowDeletionRequest) (*pb.FlowDeletionReceipt, error) {
-	return nil, nil
+	if c == nil || c.service == nil || ctx == nil || c.timeout <= 0 || c.timeout > 30*time.Second || !validDeletionRequest(in) {
+		return nil, errInvalid
+	}
+	q := proto.Clone(in).(*pb.FlowDeletionRequest)
+	app, flow, operation := q.AppId, q.FlowId, q.OperationId
