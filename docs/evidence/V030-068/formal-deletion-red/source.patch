+		return workflowcatalog.ErrNotReady
+	}
+	for {
+		if e := ctx.Err(); e != nil {
+			return e
+		}
+		worked, e := a.DispatchDeletion(ctx)
+		if e != nil && ctx.Err() != nil {
+			return ctx.Err()
+		}
+		if worked && e == nil {
+			continue
+		}
+		timer := time.NewTimer(200 * time.Millisecond)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return ctx.Err()
