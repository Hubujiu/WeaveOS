+		}
+		var n int
+		if e := f.owner.QueryRow(f.ctx, "SELECT count(*) FROM applications.record_lifecycle_events WHERE app_id=$1", f.app).Scan(&n); e != nil || n != 1 {
+			t.Fatalf("duplicate permanent events: %d %v", n, e)
