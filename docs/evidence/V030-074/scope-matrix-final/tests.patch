+func TestRootStructureCopyOppositeDirectionsKeepBothTargetsIndependent(t *testing.T) {
+	f := rootHTTPTaskSetup(t)
+	s := apptemplates.Service{Pool: f.runtime}
+	p := rootTemplatePrincipal(f)
+	p.SessionRef = ""
+	rootTemplateGrantCreate(t, f, f.actor)
+	seed := rootCopyPlanInput(f)
+	seed.Source.Kind = "application"
+	seed.Source.ID = f.app
+	seed.Target.AppID = nil
+	seed.Target.Name = "Opposite source"
+	seedPlan, e := s.PlanCopy(f.ctx, p, seed)
+	if e != nil {
+		t.Fatal(e)
+	}
+	seeded, e := s.ExecuteCopy(f.ctx, p, f.id(t), rootCopyPreflightInput(seedPlan, seed), applications.Metadata{RequestID: "opposite-seed"})
+	if e != nil {
+		t.Fatal(e)
+	}
+	var receipt struct{ AppID string }
+	if json.Unmarshal(seeded.Data, &receipt) != nil {
+		t.Fatal("invalid seed receipt")
+	}
+	var otherView string
+	if e = f.owner.QueryRow(f.ctx, "SELECT id::text FROM applications.form_views WHERE app_id=$1", receipt.AppID).Scan(&otherView); e != nil {
+		t.Fatal(e)
+	}
+	forward := rootCopyPlanInput(f)
+	forward.Target.AppID = &receipt.AppID
+	reverse := apptemplates.CopyPlanInput{Source: apptemplates.CopySource{AppID: receipt.AppID, Kind: "form", ID: otherView}, Target: apptemplates.CopyTarget{AppID: &f.app, Name: "Reverse copy"}}
+	fp, e := s.PlanCopy(f.ctx, p, forward)
+	if e != nil {
+		t.Fatal(e)
+	}
+	rp, e := s.PlanCopy(f.ctx, p, reverse)
+	if e != nil {
+		t.Fatal(e)
+	}
+	requests := [2]apptemplates.CopyPreflightInput{rootCopyPreflightInput(fp, forward), rootCopyPreflightInput(rp, reverse)}
+	ops := [2]string{f.id(t), f.id(t)}
+	var errs [2]error
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := range 2 {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			<-start
+			_, errs[i] = s.ExecuteCopy(f.ctx, p, ops[i], requests[i], applications.Metadata{RequestID: "opposite-copy"})
+		}(i)
+	}
+	close(start)
+	wg.Wait()
+	for _, e := range errs {
+		if e != nil {
+			t.Fatal("opposite direction failed or deadlocked", e)
+		}
+	}
+	for _, app := range []string{f.app, receipt.AppID} {
+		var tables, views int
+		var version int64
+		if e = f.owner.QueryRow(f.ctx, "SELECT structure_version,(SELECT count(*) FROM applications.logical_tables WHERE app_id=$1),(SELECT count(*) FROM applications.form_views WHERE app_id=$1) FROM applications.apps WHERE id=$1", app).Scan(&version, &tables, &views); e != nil || version != 2 || tables != 2 || views != 2 {
+			t.Fatal("opposite copy lost target integrity", version, tables, views, e)
+		}
+	}
+}
