{
  "path": {
    "post": {
      "operationId": "searchWorkflowApprovers",
      "summary": "分页读取当前有资格的流程配置审批人",
      "description": "仅当前应用owner或Bootstrap。候选须active且当前表单menu.enter及至少一个现存字段data.read，own仅配置候选资格；实际处理仍复核记录行权限。当前schema/policy或候选变化返回COMMON_QUERY_CHANGED，显式刷新第一页。只读，不写业务操作。",
      "security": [
        {
          "WebSession": []
        }
      ],
      "parameters": [
        {
          "name": "appId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        {
          "name": "viewId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        {
          "$ref": "#/components/parameters/ExpectedActor"
        },
        {
          "$ref": "#/components/parameters/CsrfToken"
        }
      ],
