import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
const api=JSON.parse(readFileSync(new URL('./openapi/openapi.json',import.meta.url))),s=api.components.schemas;
test('personal started current-instance search has closed guarded read-only admission',()=>{const p=api.paths['/api/v1/workflow-started/search'];assert.ok(p,'personal started route missing');assert.deepEqual(Object.keys(p),['post']);const op=p.post;assert.equal(op['x-max-body-bytes'],4096);assert.deepEqual(op.security,[{WebSession:[]}]);for(const name of ['CsrfToken','ExpectedActor'])assert.ok(op.parameters.some(x=>x.$ref==='#/components/parameters/'+name));assert.equal(op.requestBody.content['application/json'].schema.$ref,'#/components/schemas/WorkflowInboxSearch');assert.equal(op.responses['200'].content['application/json'].schema.$ref,'#/components/schemas/WorkflowStartedResultEnvelope')});
test('personal started current-instance projection reuses only the nine-field instance summary',()=>{const item=s.WorkflowStartedItem;assert.ok(item,'started item missing');assert.equal(item.additionalProperties,false);assert.deepEqual(item.required.toSorted(),['appId','instance','recordId','viewId']);assert.deepEqual(Object.keys(item.properties).sort(),['appId','instance','recordId','viewId']);assert.equal(item.properties.instance.$ref,'#/components/schemas/WorkflowInstanceSummary')});
test('personal started current-instance pages have complete bounded server counts',()=>{const r=s.WorkflowStartedResult;assert.ok(r,'started result missing');assert.equal(r.additionalProperties,false);assert.deepEqual(r.required.toSorted(),['items','page','pageSize','queryVersion','total']);assert.deepEqual(Object.keys(r.properties).sort(),['items','page','pageSize','queryVersion','total']);assert.equal(r.properties.items.maxItems,100);assert.ok(r.properties.items.items.oneOf?.some(v=>v.$ref==='#/components/schemas/WorkflowStartedItem'),'current closed variant must remain available');assert.equal(r.properties.total.maximum,Number.MAX_SAFE_INTEGER)});

test('personal started result admits exactly current or retained-round archived closed variants',()=>{
 assert.deepEqual(s.WorkflowStartedResult.properties.items.items,{oneOf:[{$ref:'#/components/schemas/WorkflowStartedItem'},{$ref:'#/components/schemas/WorkflowStartedArchivedItem'}]});
 const a=s.WorkflowStartedArchivedItem;assert.ok(a,'archived retained-round projection missing');assert.equal(a.additionalProperties,false);assert.deepEqual(a.required.toSorted(),['appId','archived','flowNameSource','instance','recordId','viewId']);assert.deepEqual(Object.keys(a.properties).sort(),a.required.toSorted());assert.deepEqual(a.properties.archived,{type:'boolean',const:true});assert.deepEqual(a.properties.flowNameSource.enum,['captured','legacy_last_known']);assert.equal(a.properties.instance.$ref,'#/components/schemas/WorkflowInstanceSummary');
});
