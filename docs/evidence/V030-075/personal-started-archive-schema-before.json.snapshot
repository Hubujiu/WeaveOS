{
  "WorkflowStartedItem": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "appId",
      "viewId",
      "recordId",
      "instance"
    ],
    "properties": {
      "appId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "viewId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "recordId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "instance": {
        "$ref": "#/components/schemas/WorkflowInstanceSummary"
      }
    }
  },
  "WorkflowStartedArchivedItem": null,
  "WorkflowStartedResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "items",
      "total",
      "page",
      "pageSize",
      "queryVersion"
    ],
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "$ref": "#/components/schemas/WorkflowStartedItem"
        }
      },
      "total": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "pageSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "queryVersion": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
