import test from 'node:test';
import assert from 'node:assert/strict';
import {readFile} from 'node:fs/promises';
import {stripTypeScriptTypes} from 'node:module';
const code=stripTypeScriptTypes(await readFile(new URL('../../apps/web/src/applications/api.ts',import.meta.url),'utf8'),{mode:'transform'});
const {applicationReadPost,ApplicationError}=await import('data:text/javascript;base64,'+Buffer.from(code).toString('base64'));
const actor='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
function fixture(t,respond){const old=Object.getOwnPropertyDescriptor(globalThis,'document');Object.defineProperty(globalThis,'document',{configurable:true,value:{cookie:'__Host-csrf=synthetic'}});t.after(()=>{if(old)Object.defineProperty(globalThis,'document',old);else delete globalThis.document;});const calls=[];t.mock.method(globalThis,'fetch',async(url,init)=>{calls.push({url,init});return respond(url,init);});return calls;}
test('V070 preflight POST carries exact original input and actor/CSRF without a write key',async t=>{const calls=fixture(t,()=>new Response(JSON.stringify({code:'OK',data:{valid:true},meta:null}),{status:200})),body={manifest:{format:'weaveos.structure-template'},bindings:[]},controller=new AbortController();assert.deepEqual(await applicationReadPost(actor,'application-templates/preflight',body,controller.signal),{valid:true});assert.equal(calls.length,1);assert.equal(calls[0].url,'/api/v1/application-templates/preflight');assert.equal(calls[0].init.method,'POST');assert.equal(calls[0].init.headers['X-Expected-Actor-Id'],actor);assert.equal(calls[0].init.headers['X-CSRF-Token'],'synthetic');assert.equal(calls[0].init.signal,controller.signal);assert.deepEqual(JSON.parse(calls[0].init.body),body);});
test('V070 failed read-only template preflight is not an ambiguous committed import',async t=>{fixture(t,()=>{throw Error('offline');});await assert.rejects(applicationReadPost(actor,'application-templates/preflight',{manifest:{},bindings:[]}),error=>error instanceof ApplicationError&&error.unconfirmed===false);});
test('V070 preflight read entry cannot smuggle import or another external path',async t=>{const calls=fixture(t,()=>{throw Error('must not send');});for(const path of ['application-templates/import','application-templates/preflight?x=1','application-templates/preflight/','https://example.invalid/preflight','application-templates/../import'])await assert.rejects(applicationReadPost(actor,path,{}),TypeError);assert.equal(calls.length,0);});
