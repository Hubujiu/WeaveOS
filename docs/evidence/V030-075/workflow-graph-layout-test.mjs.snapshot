import test from 'node:test';import assert from 'node:assert/strict';import {readFile} from 'node:fs/promises';import {stripTypeScriptTypes} from 'node:module';
const data=s=>'data:text/javascript;base64,'+Buffer.from(s).toString('base64');async function load(u){let s=stripTypeScriptTypes(await readFile(u,'utf8'),{mode:'transform'});for(const m of [...s.matchAll(/from ['"]([^'"]+)['"]/g)])s=s.replace(m[0],"from '"+await load(new URL(m[1]+'.ts',u))+"'");return data(s);}
const {workflowLayers}=await import(await load(new URL('../../apps/web/src/applications/workflows/graphLayout.ts',import.meta.url)));
const id=n=>'edededed-eded-4ded-8ded-'+String(n).padStart(12,'0'),start={id:id(1),kind:'start'},end={id:id(2),kind:'end'},approval={id:id(3),kind:'approval',approval:{mode:'any',assigneeIds:[id(8)],editableFieldIds:[]}},condition={id:id(4),kind:'condition',condition:{operator:'and',children:[{fieldId:id(9),operator:'gt',value:'5000.00'}]}};
const simple={version:1,nodes:[end,approval,start],edges:[{from:id(3),to:id(2)},{from:id(1),to:id(3)}]};
test('V019 display layers use edges rather than serialized node order and never mutate the definition',()=>{const before=structuredClone(simple);assert.deepEqual(workflowLayers(simple),[[start],[approval],[end]]);assert.deepEqual(simple,before);});
test('V019 direct start to end stays a valid two-layer display',()=>assert.deepEqual(workflowLayers({version:1,nodes:[end,start],edges:[{from:id(1),to:id(2)}]}),[[start],[end]]));
test('V019 unequal condition branches rejoin only after every predecessor',()=>{const g={version:1,nodes:[end,approval,condition,start],edges:[{from:id(1),to:id(4)},{from:id(4),to:id(3),branch:'true'},{from:id(4),to:id(2),branch:'false'},{from:id(3),to:id(2)}]};assert.deepEqual(workflowLayers(g),[[start],[condition],[approval],[end]]);});
test('V019 independent branch nodes share a row without duplicating a joined end',()=>{const other={...approval,id:id(5)};const g={version:1,nodes:[end,approval,condition,other,start],edges:[{from:id(1),to:id(4)},{from:id(4),to:id(3),branch:'true'},{from:id(4),to:id(5),branch:'false'},{from:id(3),to:id(2)},{from:id(5),to:id(2)}]};assert.deepEqual(workflowLayers(g),[[start],[condition],[approval,other],[end]]);assert.deepEqual(workflowLayers(g),workflowLayers(g));});
for(const[label,patch]of[['empty nodes',{nodes:[]}],['missing target',{edges:[{from:id(1),to:id(99)}]}],['cycle',{edges:[{from:id(1),to:id(3)},{from:id(3),to:id(1)}]}],['extra duplicate',{nodes:[...simple.nodes,start]}]])test('V019 invalid display graph '+label+' is rejected',()=>assert.equal(workflowLayers({...simple,...patch}),null));
