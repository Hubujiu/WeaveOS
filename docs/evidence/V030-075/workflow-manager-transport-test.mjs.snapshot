import test from 'node:test';import assert from 'node:assert/strict';import {readFile} from 'node:fs/promises';import {stripTypeScriptTypes} from 'node:module';
const source=await readFile(new URL('../../apps/web/src/applications/api.ts',import.meta.url),'utf8');const {applicationReadPost}=await import('data:text/javascript;base64,'+Buffer.from(stripTypeScriptTypes(source,{mode:'transform'})).toString('base64'));
const id='abababab-abab-4bab-8bab-abababababab',path=`applications/${id}/forms/${id}/workflows/search`;
function setup(t,handler){const old=Object.getOwnPropertyDescriptor(globalThis,'document');Object.defineProperty(globalThis,'document',{configurable:true,value:{cookie:'__Host-csrf=synthetic'}});t.after(()=>{if(old)Object.defineProperty(globalThis,'document',old);else delete globalThis.document;});t.mock.method(globalThis,'fetch',handler);}
test('V075 manager discovery carries original actor CSRF and current query over read-only POST',async t=>{let sent;setup(t,async(url,init)=>{sent={url,init};return new Response(JSON.stringify({code:'OK',data:{items:[]},meta:null}),{status:200});});const body={page:2,pageSize:20,queryVersion:'current'},signal=new AbortController().signal;assert.deepEqual(await applicationReadPost(id,path,body,signal),{items:[]});assert.equal(sent.url,'/api/v1/'+path);assert.equal(sent.init.method,'POST');assert.equal(sent.init.headers['X-Expected-Actor-Id'],id);assert.equal(sent.init.headers['X-CSRF-Token'],'synthetic');assert.equal(sent.init.credentials,'include');assert.equal(sent.init.signal,signal);assert.deepEqual(JSON.parse(sent.init.body),body);});
test('V075 manager read network failure is never unknown business mutation',async t=>{setup(t,async()=>{throw new TypeError('offline');});await assert.rejects(applicationReadPost(id,path,{page:1,pageSize:20}),e=>e.status===0&&e.unconfirmed===false);});
for(const suffix of ['?x=1','#x','/','/definition','/enable'])test('V075 manager discovery refuses suffix '+suffix,async t=>{let calls=0;setup(t,async()=>{calls++;throw Error('no request');});await assert.rejects(applicationReadPost(id,path+suffix,{}),TypeError);assert.equal(calls,0);});
for(const other of [path.replace('/search','/'+id+'/publish'),path.replace('/search','/'+id+'/definition'),path.replace(id,'00000000-0000-0000-0000-000000000000'),path.replace(id,id.toUpperCase())])test('V075 manager transport does not admit mutation or invalid authority path '+other,async t=>{let calls=0;setup(t,async()=>{calls++;throw Error('no request');});await assert.rejects(applicationReadPost(id,other,{}),TypeError);assert.equal(calls,0);});
