import test from 'node:test';import assert from 'node:assert/strict';import {readFile} from 'node:fs/promises';import {stripTypeScriptTypes} from 'node:module';
const s=stripTypeScriptTypes(await readFile(new URL('../../apps/web/src/applications/workflows/publicationContract.ts',import.meta.url),'utf8'),{mode:'transform'}),{validPublicationRequest:request,validPublicationResult:valid}=await import('data:text/javascript;base64,'+Buffer.from(s).toString('base64'));
const id=n=>'bebebebe-bebe-4ebe-8ebe-'+String(n).padStart(12,'0'),resource={kind:'workflow-publication',appId:id(1),viewId:id(2),id:id(3),version:2},q={path:`applications/${id(1)}/forms/${id(2)}/workflows/${id(3)}/publish`,method:'POST',expectedStatus:202,body:{expectedRevision:4,expectedSchemaVersion:3}},r={operationId:id(9),flowId:id(3),version:2,status:'pending',reason:null};
test('V027 publication admission has immutable resource and version, not a definition save',()=>assert.equal(request(resource,q),true));
for(const[key,value]of[['path',q.path+'?x=1'],['path',q.path.replace('/publish','/definition')],['method','PUT'],['expectedStatus',200],['body',{...q.body,operationId:id(8)}],['body',{...q.body,bpmn:'xml'}],['body',{...q.body,expectedRevision:0}],['body',{...q.body,expectedSchemaVersion:2**53}]])test('V027 rejects publish request '+key+JSON.stringify(value),()=>assert.equal(request(resource,{...q,[key]:value}),false));
for(const patch of [{kind:'workflow-definition'},{version:0},{version:'2'},{id:'../escape'},{appId:id(1).toUpperCase()},{viewId:'00000000-0000-0000-0000-000000000000'},{actor:id(7)}])test('V027 rejects resource '+JSON.stringify(patch),()=>assert.equal(request({...resource,...patch},q),false));
const cases=[['pending',null],['unknown','DEPENDENCY_UNAVAILABLE'],['unknown','ENGINE_REPLY_INVALID'],['unknown','ENGINE_CONFLICT'],['confirmed',null],['superseded','CANDIDATE_SUPERSEDED'],['blocked','AUTHORITY_REVOKED'],['blocked','APPROVER_INELIGIBLE'],['blocked','SCHEMA_INCOMPATIBLE'],['blocked','FLOW_CLOSED'],['blocked','ENGINE_CONFLICT']];
for(const[status,reason]of cases)for(const method of ['GET','POST'])test('V027 '+method+' bound '+status+' '+reason,()=>assert.equal(valid({...r,status,reason},id(9),id(3),2,method==='GET'||!['pending','unknown'].includes(status)?200:202,method),true));
for(const patch of [{operationId:id(8)},{flowId:id(8)},{version:1},{version:2**53},{version:'2'},{status:'success'},{reason:'raw SQL exception'},{status:'confirmed',reason:'FLOW_CLOSED'},{status:'blocked',reason:null},{status:'pending',reason:'DEPENDENCY_UNAVAILABLE'},{status:'unknown',reason:null},{status:'superseded',reason:'ENGINE_CONFLICT'},{bpmn:'private'}, {engineDeploymentId:'private'}])test('V027 rejects publication result '+JSON.stringify(patch),()=>assert.equal(valid({...r,...patch},id(9),id(3),2,202,'POST'),false));
test('V027 accepted POST cannot masquerade as a 200 final receipt',()=>assert.equal(valid(r,id(9),id(3),2,200,'POST'),false));
test('V027 terminal POST cannot masquerade as a 202 pending receipt',()=>assert.equal(valid({...r,status:'confirmed'},id(9),id(3),2,202,'POST'),false));
test('V027 GET only accepts actual 200',()=>assert.equal(valid(r,id(9),id(3),2,202,'GET'),false));
