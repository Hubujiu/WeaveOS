{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "tests/e2e/**/*.ts",
    "tests/acceptance/**/*.ts",
    "services/workflow-engine/formal-browser.spec.ts",
    "services/workflow-engine/playwright.product.config.ts"
  ]
}
